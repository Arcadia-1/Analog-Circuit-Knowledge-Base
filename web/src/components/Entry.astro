---
import Thumb from './Thumb.astro';
import type { Illustration } from '../data/illustrations';

/** A compact cover tile: one recognisable preview with its title directly underneath. */
interface Props { item: Illustration }
const { item } = Astro.props;
const away = Boolean(item.external);
---
<a class="entry" href={item.href} target={away ? '_blank' : undefined} rel={away ? 'noopener noreferrer' : undefined}>
  <div class="preview"><Thumb kind={item.thumb} /></div>
  <div class="description">
    <div class="heading">
      <h3 set:html={item.title.replace(/-N\b/g, '-<var>N</var>')} />
      <span class="arrow" aria-hidden="true">↗</span>
    </div>
  </div>
  {away && <span class="sr-only"> (opens in a new tab)</span>}
</a>

<style>
  .entry { display: inline-block; width: 100%; min-width: 0; margin: 0 0 22px; padding: 0 0 14px; break-inside: avoid; vertical-align: top; border-bottom: 1px solid var(--rule); color: inherit; text-decoration: none; }
  .preview, .description { min-width: 0; }
  .preview { padding: 16px 14px 14px; border: 1px solid var(--rule-soft); background: var(--plot); transition: border-color 0.15s, background-color 0.15s; }
  .preview :global(.thumb) { width: 100%; }
  .heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 11px 4px 0; }
  h3 { margin: 0; font-size: 17px; line-height: 1.32; font-weight: 600; letter-spacing: -0.025em; }
  h3 :global(var) { font-size: 1.08em; }
  .arrow { flex: none; color: var(--ink-3); font-size: 16px; transition: color 0.15s, transform 0.15s; }
  .entry:hover .preview, .entry:focus-visible .preview { border-color: var(--rule); background: color-mix(in srgb, var(--plot) 70%, var(--brand-soft)); }
  .entry:hover .arrow, .entry:focus-visible .arrow { color: var(--brand); transform: translate(2px, -2px); }
  .entry:hover h3 { color: var(--brand); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 520px) { .entry { margin-bottom: 20px; } .preview { padding: 18px 16px 16px; } h3 { font-size: 18px; } }
</style>

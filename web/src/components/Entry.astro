---
import Thumb from './Thumb.astro';
import type { Illustration } from '../data/illustrations';

/** A compact course entry with a visual preview, title and one-sentence orientation. */
interface Props { item: Illustration }
const { item } = Astro.props;
const away = Boolean(item.external);
---
<a class="entry" data-category={item.category} href={item.href} target={away ? '_blank' : undefined} rel={away ? 'noopener noreferrer' : undefined}>
  <div class="preview"><Thumb kind={item.thumb} /></div>
  <div class="description">
    {item.category && <span class="category">{item.category}</span>}
    <div class="heading">
      <h3 set:html={item.title.replace(/-N\b/g, '-<var>N</var>')} />
      <span class="arrow" aria-hidden="true">↗</span>
    </div>
    <p>{item.summary}</p>
  </div>
  {away && <span class="sr-only"> (opens in a new tab)</span>}
</a>

<style>
  .entry { display: grid; grid-template-columns: 140px minmax(0, 1fr); align-items: center; gap: 18px; min-width: 0; padding: 15px 12px; border-bottom: 1px solid var(--rule); color: inherit; text-decoration: none; transition: background-color 0.15s; }
  .entry[hidden] { display: none; }
  .entry:hover { background: var(--plot); }
  .preview, .description { min-width: 0; }
  .preview :global(.thumb) { width: 100%; }
  .category { display: block; margin-bottom: 4px; color: var(--brand); font: 500 12px/1.25 var(--mono); letter-spacing: 0.015em; }
  .heading { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  h3 { margin: 0; font-size: 17px; line-height: 1.35; font-weight: 500; letter-spacing: -0.018em; }
  h3 :global(var) { font-size: 1.08em; }
  .entry p { margin: 5px 0 0; color: var(--ink-2); font-size: 13px; line-height: 1.5; text-wrap: pretty; }
  .arrow { flex: none; color: var(--ink-3); font-size: 16px; transition: color 0.15s, transform 0.15s; }
  .entry:hover .arrow, .entry:focus-visible .arrow { color: var(--brand); transform: translate(2px, -2px); }
  .entry:hover h3 { color: var(--brand); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (min-width: 601px) and (max-width: 1000px) { .entry { grid-template-columns: minmax(0, 1fr); align-content: start; gap: 13px; } .preview { width: 140px; } }
  @media (max-width: 600px) { .entry { grid-template-columns: 112px minmax(0, 1fr); padding: 15px 0; gap: 16px; } h3 { font-size: 16px; } }
  @media (max-width: 360px) { .entry { grid-template-columns: 108px minmax(0, 1fr); gap: 14px; } .heading { gap: 6px; } }
</style>

---
import Thumb from './Thumb.astro';
import type { Column } from '../data/columns';

/** A course hosted on another site: preview, title, orientation and its parts in order. Opens in a new tab. */
interface Props { column: Column }
const { column } = Astro.props;
---
<a class="column" href={column.href} target="_blank" rel="noopener noreferrer" lang="zh-CN">
  <div class="preview"><Thumb kind={column.thumb} /></div>
  <div class="description">
    <span class="source">{column.site} · {column.chapters} 讲</span>
    <div class="heading">
      <h3>{column.title}</h3>
      <span class="arrow" aria-hidden="true">↗</span>
    </div>
    <p>{column.summary}</p>
    <ol class="parts" aria-label="课程分为五部分">
      {column.parts.map((part) => <li>{part}</li>)}
    </ol>
  </div>
  <span class="sr-only" lang="en"> (opens in a new tab)</span>
</a>

<style>
  .column { display: grid; grid-template-columns: 140px minmax(0, 1fr); align-items: center; gap: 18px; min-width: 0; padding: 15px 12px; border-bottom: 1px solid var(--rule); color: inherit; text-decoration: none; transition: background-color 0.15s; }
  .column:hover { background: var(--plot); }
  .preview, .description { min-width: 0; }
  .preview :global(.thumb) { width: 100%; }
  .source { display: block; margin-bottom: 4px; color: var(--brand); font: 500 12px/1.25 var(--mono); letter-spacing: 0.015em; }
  .heading { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  h3 { margin: 0; font-size: 17px; line-height: 1.35; font-weight: 500; letter-spacing: -0.01em; }
  p { margin: 5px 0 0; max-width: 72ch; color: var(--ink-2); font-size: 13px; line-height: 1.6; text-wrap: pretty; }
  .parts { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 0; padding: 0; list-style: none; counter-reset: part; }
  .parts li { counter-increment: part; padding: 2px 9px; border-radius: 999px; background: var(--chip); color: var(--ink-2); font-size: 12px; white-space: nowrap; }
  .parts li::before { content: counter(part) ' '; color: var(--ink-3); font: 11px var(--mono); }
  .arrow { flex: none; color: var(--ink-3); font-size: 16px; transition: color 0.15s, transform 0.15s; }
  .column:hover .arrow, .column:focus-visible .arrow { color: var(--brand); transform: translate(2px, -2px); }
  .column:hover h3 { color: var(--brand); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 600px) { .column { grid-template-columns: 112px minmax(0, 1fr); padding: 15px 0; gap: 16px; } h3 { font-size: 16px; } }
  @media (max-width: 360px) { .column { grid-template-columns: 108px minmax(0, 1fr); gap: 14px; } }
</style>

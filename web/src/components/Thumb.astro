---
/** Small schematic previews for the home page. */
interface Props { kind: 'pll' | 'divider' | 'sar' | 'inl' | 'err' | 'win' | 'fold' | 'ntf' | 'ti' | 'bits' | 'polar' | 'bode' | 'floor' | 'fom' | 'harm' | 'record' | 'repeat' | 'short' | 'train' }
const { kind } = Astro.props;
const xs = Array.from({ length: 13 }, (_, i) => 6 + i * 14);
const saw = [-14, -8, -2, 6, 14];
const residues = [58, -26, 12, -6, 3, -1.5, 0.8, -0.4];
const ys = (r: number) => 50 - Math.sign(r) * Math.log2(1 + Math.abs(r)) * 6.5;
// a bow of INL over a scatter of DNL stems
const wiggle = [0.3, -0.5, 0.2, 0.6, -0.3, 0.1, -0.6, 0.4, 0.2, -0.2, 0.5, -0.4, 0.3];
const bow = (x: number) => 34 - 20 * (1 - ((x - 94) / 94) ** 2);
// an error that rides on the slope of the input: zero at the peaks, worst at the crossings
const pm = (x: number) => 50 - 26 * Math.sin((2 * Math.PI * x) / 94) * Math.abs(Math.sin((Math.PI * x) / 188));
// one clean line against a skirt of leakage
const skirt = (x: number) => 86 - 52 / (1 + ((x - 94) / 7) ** 2) ** 0.55;
// the fold: one tooth per pair of zones, and the input of every zone that lands at the same height
const tooth = 31, low = 94, high = 28, level = 76;
const teeth = Array.from({ length: 7 }, (_, k) => `${k * tooth},${k % 2 ? high : low}`).join(' ');
const hit = ((low - level) / (low - high)) * tooth;
const hits = Array.from({ length: 6 }, (_, z) => (z % 2 ? (z + 1) * tooth - hit : z * tooth + hit));
// noise shaped out of the band: a floor that climbs with frequency, and the tone standing in the band
const climb = Array.from({ length: 47 }, (_, i) => `${4 + i * 4},${92 - 60 * ((4 + i * 4) / 188) ** 1.6 + ((i * 7) % 5) * 1.4}`).join(' ');
// four channels on a 0 … fs/2 axis: offset tones at fs/4 and fs/2, images of the tone at fin + k·fs/4, folded
const tone = 22, quarter = 92;
const images = [quarter - tone, quarter + tone, 2 * quarter - tone].map((x, i) => ({ x, top: [58, 50, 66][i] }));
const offsets = [{ x: quarter, top: 42 }, { x: 2 * quarter, top: 70 }];
// twelve bits set about half the time, one of them far less
const usage = [0.2, -0.3, 0.1, 0.5, -0.2, 0.8, 1.4, 1.9, 1.1, -0.6, -6.5, 0.4];
// a polar spectrum: a cloud of noise around the centre, the tone straight up, two harmonics at their phases
const cloud = Array.from({ length: 60 }, (_, i) => {
  const a = i * 2.399, r = 8 + ((i * 37) % 13);
  return `M${94 + r * Math.sin(a)},${56 - r * Math.cos(a)}h0.01`;
}).join('');
const ray = (deg: number, r: number) => [94 + r * Math.sin((deg * Math.PI) / 180), 56 - r * Math.cos((deg * Math.PI) / 180)];
// a first-order roll-off: the straight asymptote, and the curve that rounds its corner
const corner = 70, decade = 45, perDb = 1.1, flat = 26;
const dbAt = (x: number) => flat + perDb * 10 * Math.log10(1 + 10 ** ((2 * (x - corner)) / decade));
const exact = Array.from({ length: 41 }, (_, i) => `${4 + i * 4.6},${dbAt(4 + i * 4.6).toFixed(1)}`).join(' ');
// one tone over two noise floors, the raised one with a pair of harmonics standing out of it
// one curve that rises to meet a target as training grows, and one that starts above it and comes back down
const target = 34;
const learns = Array.from({ length: 9 }, (_, i) => `${12 + i * 20},${(target + 46 * 2 ** -(i / 1.4)).toFixed(1)}`).join(' ');
const overfits = Array.from({ length: 9 }, (_, i) => `${12 + i * 20},${(target - 26 * 2 ** -(i / 1.2)).toFixed(1)}`).join(' ');
// SFDR climbing with the record length until the harmonic that is really there stops it, over a flat SNDR
const ceiling = 26, climbs = Array.from({ length: 11 }, (_, i) => {
  const x = 10 + i * 17;
  return `${x},${(ceiling + 52 * 2 ** -(i / 2.6)).toFixed(1)}`;
}).join(' ');
const steady = Array.from({ length: 11 }, (_, i) => `${10 + i * 17},${76 - (i < 3 ? (3 - i) * 2 : 0)}`).join(' ');
// repeatability tightens with sqrt(N); short near-Nyquist records alternate between incompatible answers
const repeatability = Array.from({ length: 11 }, (_, i) => `${10 + i * 17},${(82 - 50 * (1 - 2 ** (-i / 3))).toFixed(1)}`).join(' ');
const shortEven = Array.from({ length: 7 }, (_, i) => `${10 + i * 28},${[30, 62, 48, 69, 55, 64, 58][i]}`).join(' ');
const shortOdd = Array.from({ length: 7 }, (_, i) => `${10 + i * 28},${[72, 44, 67, 49, 61, 46, 52][i]}`).join(' ');
const dividerAcc = [0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1];
const dividerMash = [0, 1, -2, 3, -2, 1, 0, 0, 1, -2, 3, -2];
// a sine bent by a square term, and under it the harmonic the bend leaves behind
const wave = (f: (u: number, t: number) => number, at: number, gain: number) =>
  Array.from({ length: 63 }, (_, i) => {
    const t = (2 * Math.PI * i) / 62;
    return `${4 + i * 3},${(at - gain * f(Math.sin(t), t)).toFixed(1)}`;
  }).join(' ');
const bent = wave((u) => u + 0.35 * u * u, 44, 26);
const residue = wave((u) => u * u - 0.5, 88, 18);
// lines of constant energy per conversion step, and one part sitting under them
const fom = (at: number) => `4,${at} 188,${at + 52}`;
const jag = (base: number, seed: number) => Array.from({ length: 47 }, (_, i) => `${4 + i * 4},${base - ((i * seed) % 5) * 1.1}`).join(' ');
const asymptote = `4,${flat} ${corner},${flat} 188,${(flat + (perDb * 20 * (188 - corner)) / decade).toFixed(1)}`;
---
<svg class="thumb" viewBox="0 0 188 100" aria-hidden="true">
  {kind === 'pll' ? (
    <>
      <text x="0" y="10">integer-N</text>
      <line class="base" x1="0" y1="30" x2="188" y2="30" />
      {xs.map((x, i) => <g class="s1"><line x1={x} y1="30" x2={x} y2={30 + ((i % 3) - 1)} /><circle cx={x} cy={30 + ((i % 3) - 1)} r="2.2" /></g>)}
      <text x="0" y="56">fractional-N</text>
      <line class="base" x1="0" y1="78" x2="188" y2="78" />
      {xs.map((x, i) => <g class="s2"><line x1={x} y1="78" x2={x} y2={78 + saw[i % 5]} /><circle cx={x} cy={78 + saw[i % 5]} r="2.2" /></g>)}
    </>
  ) : kind === 'divider' ? (
    <>
      <text x="0" y="10">divider words</text>
      <line class="base" x1="0" y1="38" x2="188" y2="38" />
      {dividerAcc.map((v, i) => <line class="s1" x1={8 + i * 15.5} y1="38" x2={8 + i * 15.5} y2={38 - v * 18} />)}
      <line class="base" x1="0" y1="78" x2="188" y2="78" />
      {dividerMash.map((v, i) => <line class="s2" x1={8 + i * 15.5} y1="78" x2={8 + i * 15.5} y2={78 - v * 8} />)}
      <text x="2" y="55">1st</text><text x="2" y="96">3rd</text>
    </>
  ) : kind === 'win' ? (
    <>
      <text x="0" y="10">coherent</text>
      <line class="base" x1="0" y1="34" x2="188" y2="34" />
      <line class="s1" x1="94" y1="34" x2="94" y2="12" />
      {xs.map((x) => <line class="s1" x1={x} y1="34" x2={x} y2={x === 90 ? 34 : 32} opacity="0.5" />)}
      <text x="0" y="60">spectral leakage</text>
      <line class="base" x1="0" y1="86" x2="188" y2="86" />
      <polyline class="s2 link" points={Array.from({ length: 63 }, (_, i) => `${i * 3},${skirt(i * 3)}`).join(' ')} />
    </>
  ) : kind === 'ntf' ? (
    <>
      <text x="0" y="10">noise shaping</text>
      <rect class="win" x="0" y="18" width="46" height="76" />
      <line class="base" x1="0" y1="94" x2="188" y2="94" />
      <polyline class="s2 link" points={climb} />
      <line class="s1" x1="22" y1="94" x2="22" y2="24" />
    </>
  ) : kind === 'ti' ? (
    <>
      <text x="0" y="10">mismatch spurs</text>
      <line class="base" x1="0" y1="94" x2="188" y2="94" />
      <line class="s1" x1={tone} y1="94" x2={tone} y2="20" />
      {images.map((m) => <g><line class="s2 link" x1={m.x} y1="94" x2={m.x} y2={m.top} /><circle class="mark" cx={m.x} cy={m.top} r="3.4" /></g>)}
      {offsets.map((m) => <g><line class="s2 link" x1={m.x} y1="94" x2={m.x} y2={m.top} /><rect class="mark" x={m.x - 3.2} y={m.top - 3.2} width="6.4" height="6.4" /></g>)}
    </>
  ) : kind === 'bode' ? (
    <>
      <text x="0" y="10">poles & roll-off</text>
      <line class="base" x1="0" y1="92" x2="188" y2="92" />
      <line class="dash" x1={corner} y1="18" x2={corner} y2="92" />
      <polyline class="s1" style="fill: none" stroke-dasharray="5 4" points={asymptote} />
      <polyline class="s2" style="fill: none" points={exact} />
    </>
  ) : kind === 'train' ? (
    <>
      <text x="0" y="10">training length</text>
      <line class="base" x1="0" y1="94" x2="188" y2="94" />
      <line class="dash" x1="0" y1={target} x2="188" y2={target} />
      <polyline class="s1 link" style="stroke-width: 2" points={learns} />
      <polyline class="s2 link" style="stroke-width: 2; stroke-dasharray: 5 4" points={overfits} />
      <circle class="s1" cx="12" cy={target + 46} r="2.6" />
      <circle class="s2" cx="12" cy={target - 26} r="2.6" />
    </>
  ) : kind === 'record' ? (
    <>
      <text x="0" y="10">SFDR vs record length</text>
      <line class="base" x1="0" y1="94" x2="188" y2="94" />
      <line class="dash" x1="0" y1={ceiling} x2="188" y2={ceiling} />
      <polyline class="s1 link" style="stroke-width: 2" points={climbs} />
      <polyline class="s2 link" style="stroke-width: 2" points={steady} />
      {[0, 5, 10].map((i) => <circle class="s1" cx={10 + i * 17} cy={ceiling + 52 * 2 ** -(i / 2.6)} r="2.4" />)}
    </>
  ) : kind === 'repeat' ? (
    <>
      <text x="0" y="10">SNDR spread vs samples</text>
      <rect class="win" x="0" y="20" width="188" height="22" />
      <line class="dash" x1="0" y1="42" x2="188" y2="42" />
      <polyline class="s2 link" style="stroke-width: 2" points={repeatability} />
      {[0, 3, 6, 10].map((i) => <circle class="s2" cx={10 + i * 17} cy={82 - 50 * (1 - 2 ** (-i / 3))} r="2.5" />)}
    </>
  ) : kind === 'short' ? (
    <>
      <text x="0" y="10">too few phases</text>
      <line class="base" x1="0" y1="92" x2="188" y2="92" />
      <polyline class="s1 link" style="stroke-width: 2" points={shortEven} />
      <polyline class="s2 link" style="stroke-width: 2; stroke-dasharray: 5 4" points={shortOdd} />
      {shortEven.split(' ').map((p) => { const [x, y] = p.split(','); return <circle class="s1" cx={x} cy={y} r="2.3" />; })}
      {shortOdd.split(' ').map((p) => { const [x, y] = p.split(','); return <circle class="s2" cx={x} cy={y} r="2.3" />; })}
    </>
  ) : kind === 'floor' ? (
    <>
      <text x="0" y="10">floor vs lines</text>
      <line class="base" x1="0" y1="94" x2="188" y2="94" />
      <polyline class="quiet" points={jag(88, 7)} />
      <polyline class="s2 link" points={jag(70, 11)} />
      {[80, 120].map((x) => <line class="s2" x1={x} y1="70" x2={x} y2="50" />)}
      <line class="s1" x1="40" y1="94" x2="40" y2="16" />
    </>
  ) : kind === 'fom' ? (
    <>
      <text x="0" y="10">energy per step</text>
      <line class="base" x1="0" y1="94" x2="188" y2="94" />
      {[18, 40, 62].map((y) => <polyline class="s1 link" points={fom(y)} />)}
      <line class="dash" x1="120" y1="12" x2="120" y2="94" />
      <circle class="mark" cx="120" cy="64" r="4.6" />
    </>
  ) : kind === 'harm' ? (
    <>
      <text x="0" y="10">a bend, and its harmonic</text>
      <line class="base" x1="0" y1="44" x2="188" y2="44" />
      <polyline class="s1 link" style="stroke-width: 2" points={bent} />
      <line class="dash" x1="0" y1="88" x2="188" y2="88" />
      <polyline class="s2 link" style="stroke-width: 2" points={residue} />
    </>
  ) : kind === 'polar' ? (
    <>
      <text x="0" y="10">harmonic phase</text>
      <circle class="orbit" cx="94" cy="56" r="40" />
      <circle class="orbit" cx="94" cy="56" r="22" />
      <path class="cloud" d={cloud} />
      <line class="s1" x1="94" y1="56" x2={ray(0, 40)[0]} y2={ray(0, 40)[1]} />
      <line class="s2" x1="94" y1="56" x2={ray(118, 30)[0]} y2={ray(118, 30)[1]} />
      <line class="s2" x1="94" y1="56" x2={ray(236, 26)[0]} y2={ray(236, 26)[1]} />
    </>
  ) : kind === 'bits' ? (
    <>
      <text x="0" y="10">bit activity</text>
      <line class="dash" x1="0" y1="54" x2="188" y2="54" />
      {usage.map((u, j) => <rect class={j === 10 ? 's2' : 's1'} x={4 + j * 15.4} y={Math.min(54, 54 - u * 5)} width="8" height={Math.max(1.5, Math.abs(u * 5))} />)}
      {usage.map((_, j) => <text x={8 + j * 15.4} y="98" text-anchor="middle">{j % 11 ? '' : j + 1}</text>)}
    </>
  ) : kind === 'fold' ? (
    <>
      <text x="0" y="10">frequency folding</text>
      {[1, 3, 5].map((z) => <rect class="win" x={z * tooth} y={high} width={tooth} height={low - high} />)}
      <line class="base" x1="0" y1={low} x2="188" y2={low} />
      <polyline class="s1 link" points={teeth} />
      <line class="dash" x1="0" y1={level} x2="188" y2={level} />
      {hits.map((x, z) => <circle class={z === 2 ? 's1' : 's2'} cx={x} cy={level} r="2.6" />)}
    </>
  ) : kind === 'err' ? (
    <>
      <text x="0" y="10">residual vs phase</text>
      <line class="base" x1="0" y1="50" x2="188" y2="50" />
      <polyline class="s1 link" points={Array.from({ length: 63 }, (_, i) => `${i * 3},${pm(i * 3)}`).join(' ')} />
      {xs.map((x) => <circle class="s2" cx={x} cy={pm(x)} r="2" />)}
    </>
  ) : kind === 'inl' ? (
    <>
      <text x="0" y="10">INL</text>
      <line class="base" x1="0" y1="34" x2="188" y2="34" />
      <polyline class="s1 link" points={xs.map((x) => `${x},${bow(x)}`).join(' ')} />
      <text x="0" y="60">DNL</text>
      <line class="base" x1="0" y1="82" x2="188" y2="82" />
      {xs.map((x, i) => <line class="s2" x1={x} y1="82" x2={x} y2={82 - wiggle[i] * 16} />)}
    </>
  ) : (
    <>
      <text x="0" y="10">SAR residue</text>
      <line class="base" x1="0" y1="50" x2="188" y2="50" />
      {residues.map((_, i) => <rect class="win" x={10 + i * 23 - 5} y={50 - (7 - i) * 5.5} width="10" height={(7 - i) * 11} rx="2" />)}
      <polyline class="s1 link" points={residues.map((r, i) => `${10 + i * 23},${ys(r)}`).join(' ')} />
      {residues.map((r, i) => <circle class="s1" cx={10 + i * 23} cy={ys(r)} r="2.6" />)}
    </>
  )}
</svg>

<style>
  .thumb { width: 188px; height: auto; display: block; }
  text { fill: var(--ink-3); font: 10px var(--mono); }
  .base { stroke: var(--rule); }
  .s1 { stroke: var(--s1); fill: var(--s1); stroke-width: 2; stroke-linecap: round; }
  .s2 { stroke: var(--s2); fill: var(--s2); stroke-width: 2; stroke-linecap: round; }
  .link { fill: none; stroke-width: 1.5; opacity: 0.85; }
  .win { fill: var(--chip); }
  .dash { stroke: var(--ink-3); stroke-dasharray: 3 3; }
  .mark { fill: var(--ground); stroke: var(--s2); stroke-width: 1.6; }
  .orbit { fill: none; stroke: var(--rule); }
  .quiet { fill: none; stroke: var(--rule); stroke-width: 1.5; }
  .cloud { stroke: var(--ink-3); stroke-width: 2.2; stroke-linecap: round; opacity: 0.6; }
</style>

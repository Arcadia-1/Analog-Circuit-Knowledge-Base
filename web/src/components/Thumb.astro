---
/** Small schematic previews for the home page. */
interface Props { kind: 'pll' | 'sar' | 'inl' | 'err' | 'win' | 'fold' | 'ntf' | 'ti' }
const { kind } = Astro.props;
const xs = Array.from({ length: 13 }, (_, i) => 6 + i * 14);
const saw = [-14, -8, -2, 6, 14];
const residues = [58, -26, 12, -6, 3, -1.5, 0.8, -0.4];
const ys = (r: number) => 50 - Math.sign(r) * Math.log2(1 + Math.abs(r)) * 6.5;
// a bow of INL over a scatter of DNL stems
const wiggle = [0.3, -0.5, 0.2, 0.6, -0.3, 0.1, -0.6, 0.4, 0.2, -0.2, 0.5, -0.4, 0.3];
const bow = (x: number) => 34 - 20 * (1 - ((x - 94) / 94) ** 2);
// an error that rides on the slope of the input: zero at the peaks, worst at the crossings
const pm = (x: number) => 50 - 26 * Math.sin((2 * Math.PI * x) / 94) * Math.abs(Math.sin((Math.PI * x) / 188));
// one clean line against a skirt of leakage
const skirt = (x: number) => 86 - 52 / (1 + ((x - 94) / 7) ** 2) ** 0.55;
// the fold: one tooth per pair of zones, and the input of every zone that lands at the same height
const tooth = 31, low = 94, high = 28, level = 76;
const teeth = Array.from({ length: 7 }, (_, k) => `${k * tooth},${k % 2 ? high : low}`).join(' ');
const hit = ((low - level) / (low - high)) * tooth;
const hits = Array.from({ length: 6 }, (_, z) => (z % 2 ? (z + 1) * tooth - hit : z * tooth + hit));
// noise shaped out of the band: a floor that climbs with frequency, and the tone standing in the band
const climb = Array.from({ length: 47 }, (_, i) => `${4 + i * 4},${92 - 60 * ((4 + i * 4) / 188) ** 1.6 + ((i * 7) % 5) * 1.4}`).join(' ');
// four channels on a 0 … fs/2 axis: offset tones at fs/4 and fs/2, images of the tone at fin + k·fs/4, folded
const tone = 22, quarter = 92;
const images = [quarter - tone, quarter + tone, 2 * quarter - tone].map((x, i) => ({ x, top: [58, 50, 66][i] }));
const offsets = [{ x: quarter, top: 42 }, { x: 2 * quarter, top: 70 }];
---
<svg class="thumb" viewBox="0 0 188 100" aria-hidden="true">
  {kind === 'pll' ? (
    <>
      <text x="0" y="10">integer-N</text>
      <line class="base" x1="0" y1="30" x2="188" y2="30" />
      {xs.map((x, i) => <g class="s1"><line x1={x} y1="30" x2={x} y2={30 + ((i % 3) - 1)} /><circle cx={x} cy={30 + ((i % 3) - 1)} r="2.2" /></g>)}
      <text x="0" y="56">fractional-N</text>
      <line class="base" x1="0" y1="78" x2="188" y2="78" />
      {xs.map((x, i) => <g class="s2"><line x1={x} y1="78" x2={x} y2={78 + saw[i % 5]} /><circle cx={x} cy={78 + saw[i % 5]} r="2.2" /></g>)}
    </>
  ) : kind === 'win' ? (
    <>
      <text x="0" y="10">coherent</text>
      <line class="base" x1="0" y1="34" x2="188" y2="34" />
      <line class="s1" x1="94" y1="34" x2="94" y2="12" />
      {xs.map((x) => <line class="s1" x1={x} y1="34" x2={x} y2={x === 90 ? 34 : 32} opacity="0.5" />)}
      <text x="0" y="60">off by a tenth of a bin</text>
      <line class="base" x1="0" y1="86" x2="188" y2="86" />
      <polyline class="s2 link" points={Array.from({ length: 63 }, (_, i) => `${i * 3},${skirt(i * 3)}`).join(' ')} />
    </>
  ) : kind === 'ntf' ? (
    <>
      <text x="0" y="10">noise pushed out of the band</text>
      <rect class="win" x="0" y="18" width="46" height="76" />
      <line class="base" x1="0" y1="94" x2="188" y2="94" />
      <polyline class="s2 link" points={climb} />
      <line class="s1" x1="22" y1="94" x2="22" y2="24" />
    </>
  ) : kind === 'ti' ? (
    <>
      <text x="0" y="10">a spur for every mismatch</text>
      <line class="base" x1="0" y1="94" x2="188" y2="94" />
      <line class="s1" x1={tone} y1="94" x2={tone} y2="20" />
      {images.map((m) => <g><line class="s2 link" x1={m.x} y1="94" x2={m.x} y2={m.top} /><circle class="mark" cx={m.x} cy={m.top} r="3.4" /></g>)}
      {offsets.map((m) => <g><line class="s2 link" x1={m.x} y1="94" x2={m.x} y2={m.top} /><rect class="mark" x={m.x - 3.2} y={m.top - 3.2} width="6.4" height="6.4" /></g>)}
    </>
  ) : kind === 'fold' ? (
    <>
      <text x="0" y="10">input → where it lands</text>
      {[1, 3, 5].map((z) => <rect class="win" x={z * tooth} y={high} width={tooth} height={low - high} />)}
      <line class="base" x1="0" y1={low} x2="188" y2={low} />
      <polyline class="s1 link" points={teeth} />
      <line class="dash" x1="0" y1={level} x2="188" y2={level} />
      {hits.map((x, z) => <circle class={z === 2 ? 's1' : 's2'} cx={x} cy={level} r="2.6" />)}
    </>
  ) : kind === 'err' ? (
    <>
      <text x="0" y="10">residual vs phase</text>
      <line class="base" x1="0" y1="50" x2="188" y2="50" />
      <polyline class="s1 link" points={Array.from({ length: 63 }, (_, i) => `${i * 3},${pm(i * 3)}`).join(' ')} />
      {xs.map((x) => <circle class="s2" cx={x} cy={pm(x)} r="2" />)}
    </>
  ) : kind === 'inl' ? (
    <>
      <text x="0" y="10">INL</text>
      <line class="base" x1="0" y1="34" x2="188" y2="34" />
      <polyline class="s1 link" points={xs.map((x) => `${x},${bow(x)}`).join(' ')} />
      <text x="0" y="60">DNL</text>
      <line class="base" x1="0" y1="82" x2="188" y2="82" />
      {xs.map((x, i) => <line class="s2" x1={x} y1="82" x2={x} y2={82 - wiggle[i] * 16} />)}
    </>
  ) : (
    <>
      <text x="0" y="10">residue</text>
      <line class="base" x1="0" y1="50" x2="188" y2="50" />
      {residues.map((_, i) => <rect class="win" x={10 + i * 23 - 5} y={50 - (7 - i) * 5.5} width="10" height={(7 - i) * 11} rx="2" />)}
      <polyline class="s1 link" points={residues.map((r, i) => `${10 + i * 23},${ys(r)}`).join(' ')} />
      {residues.map((r, i) => <circle class="s1" cx={10 + i * 23} cy={ys(r)} r="2.6" />)}
    </>
  )}
</svg>

<style>
  .thumb { width: 188px; height: auto; display: block; }
  text { fill: var(--ink-3); font: 10px var(--mono); }
  .base { stroke: var(--rule); }
  .s1 { stroke: var(--s1); fill: var(--s1); stroke-width: 2; stroke-linecap: round; }
  .s2 { stroke: var(--s2); fill: var(--s2); stroke-width: 2; stroke-linecap: round; }
  .link { fill: none; stroke-width: 1.25; opacity: 0.5; }
  .win { fill: var(--chip); }
  .dash { stroke: var(--ink-3); stroke-dasharray: 3 3; }
  .mark { fill: var(--ground); stroke: var(--s2); stroke-width: 1.6; }
</style>

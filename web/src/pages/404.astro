---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · AMS Class" description="This page does not exist.">
  <main>
    <h1>This page does not exist</h1>
    <p>The address may have changed. <a href="/">Go to AMS Class</a> to see every illustration.</p>
  </main>
</Base>

<style>
  main { min-height: 100dvh; display: grid; place-content: center; gap: 8px; font-size: 16px; }
  h1 { margin: 0; font-size: 28px; font-weight: 500; }
  p { margin: 0; color: var(--ink-2); }
  a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--rule); }
</style>

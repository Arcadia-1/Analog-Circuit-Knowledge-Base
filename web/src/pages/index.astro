---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { featuredLessons } from '../data/illustrations';
const SIGNAL_W = 240;
const SIGNAL_H = 180;
const sineY = (phase: number) => SIGNAL_H / 2 - 58 * Math.sin(2 * Math.PI * phase);
const analogPath = Array.from({ length: 161 }, (_, i) =>
  `${i === 0 ? 'M' : 'L'}${(SIGNAL_W * i / 160).toFixed(2)} ${sineY(i / 160).toFixed(2)}`,
).join(' ');
const digitalPath = `M0 ${SIGNAL_H / 2} ` + Array.from({ length: 32 }, (_, i) => {
  const sample = i + 1;
  const y = SIGNAL_H / 2 + 10 * Math.round((sineY(sample / 32) - SIGNAL_H / 2) / 10);
  return `H${(SIGNAL_W * sample / 32).toFixed(2)}V${y}`;
}).join(' ');
---
<Base
  title="Circuits & Systems Classroom"
  description="Explore interactive lessons on data converters, PLLs, clocking and feedback, with selected tools for circuit and system analysis."
>
  <main>
    <section class="hero" aria-labelledby="site-title">
      <div class="hero-inner">
        <div class="title-row">
          <h1 id="site-title">Circuits &amp; Systems Classroom</h1>
          <span>Interactive Playground</span>
        </div>
        <div class="signal" aria-hidden="true">
          <svg viewBox="0 0 240 180" fill="none">
            <path class="signal-grid" d="M0 30h240M0 60h240M0 90h240M0 120h240M0 150h240M30 0v180M60 0v180M90 0v180M120 0v180M150 0v180M180 0v180M210 0v180" />
            <path class="analog" d={analogPath} />
            <path class="digital" d={digitalPath} />
          </svg>
        </div>
      </div>
    </section>

    <div class="content">
      <section id="lessons" aria-label="Interactive lessons">
        <div class="lesson-grid">
          {featuredLessons.map((item) => <Entry item={item} />)}
        </div>
      </section>
    </div>
  </main>
</Base>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--rule-soft); }
  .hero::before { content: ''; position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(var(--rule-soft) 1px, transparent 1px), linear-gradient(90deg, var(--rule-soft) 1px, transparent 1px); background-size: 32px 32px; mask-image: linear-gradient(90deg, transparent 20%, #000 100%); opacity: 0.45; }
  .hero-inner { position: relative; max-width: 1152px; margin: auto; padding: 20px 32px 18px; display: flex; justify-content: space-between; align-items: center; gap: 48px; }
  .title-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 18px; }
  h1 { margin: 0; font-size: clamp(34px, 4vw, 46px); line-height: 1.1; font-weight: 550; letter-spacing: -0.04em; }
  .title-row span { color: var(--ink-2); font-size: 15px; font-weight: 450; letter-spacing: -0.01em; white-space: nowrap; }
  .signal { box-sizing: border-box; width: 190px; margin-right: 34px; padding-inline: 4px; opacity: 0.85; }
  .signal svg { display: block; width: 100%; }
  .signal-grid { stroke: var(--rule); stroke-width: 0.6; }
  .analog { stroke: var(--ink-3); stroke-width: 1.3; stroke-dasharray: 3 4; opacity: 0.6; }
  .digital { stroke: var(--brand); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .content { max-width: 1152px; margin: auto; padding: 24px 32px 40px; }
  .lesson-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; }
  @media (max-width: 760px) { .signal { width: 150px; margin: 0 12px 0 0; padding-inline: 0; } .hero-inner { gap: 24px; } .lesson-grid { column-gap: 22px; } }
  @media (max-width: 600px) {
    .hero-inner { padding: 26px 20px; }
    .signal { display: none; }
    .content { padding: 24px 20px 32px; }
    .lesson-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>

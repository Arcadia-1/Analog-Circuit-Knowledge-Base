---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { related, topics } from '../data/illustrations';
const lessons = topics.flatMap((topic) => topic.items);
---
<Base
  title="ADC Toolbox"
  description="Learn how analog-to-digital converters work with interactive lessons on sampling, SAR conversion, calibration, spectra and noise. Explore in your browser, then go further with the ADCToolbox Python library."
>
  <main>
    <div class="content">
      <section id="lessons" aria-label="Interactive lessons">
        <div class="lesson-grid">
          {lessons.map((item) => <Entry item={item} />)}
        </div>
      </section>

      <section id="related" aria-labelledby="related-title">
        <div class="section-head">
          <h2 id="related-title">More to explore</h2>
        </div>
        <div class="lesson-grid related-grid">
          {related.items.map((item) => <Entry item={item} />)}
        </div>
      </section>
    </div>
  </main>
</Base>

<style>
  .content { max-width: 1152px; margin: auto; padding: 30px 32px 40px; }
  .section-head { padding-bottom: 13px; margin-bottom: 20px; border-bottom: 1px solid var(--rule); }
  h2 { margin: 0; font-size: 15px; font-weight: 600; letter-spacing: -0.02em; }
  .lesson-grid { column-count: 4; column-gap: 22px; }
  .related-grid { column-count: 3; }
  #related { margin-top: 20px; }
  @media (max-width: 1000px) { .lesson-grid, .related-grid { column-count: 3; } }
  @media (max-width: 760px) { .lesson-grid, .related-grid { column-count: 2; column-gap: 20px; } }
  @media (max-width: 600px) {
    .content { padding: 24px 20px 32px; }
    .lesson-grid, .related-grid { column-count: 1; }
    #related { margin-top: 26px; }
  }
</style>

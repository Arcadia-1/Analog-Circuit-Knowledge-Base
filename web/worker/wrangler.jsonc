{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // First-party analytics for the site (module in ../analytics); the pages themselves stay on Cloudflare Pages.
  "name": "ams-class-analytics",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "circuits-and-systems.tokenzhang.com/api/*", "zone_name": "tokenzhang.com" },
    { "pattern": "adctoolbox.tokenzhang.com/api/*", "zone_name": "tokenzhang.com" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "VISIT_STATS", "class_name": "VisitStatsDurableObject" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AnalyticsDO"] },
    { "tag": "v2", "deleted_classes": ["AnalyticsDO"], "new_sqlite_classes": ["VisitStatsDurableObject"] }
  ],
  "observability": { "enabled": true }
}
